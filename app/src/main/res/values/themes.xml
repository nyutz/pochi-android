<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Pochi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.Pochi.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.Pochi.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Pochi.Button.Feed" parent="Widget.Pochi.Button">
        <item name="backgroundTint">@color/btn_feed</item>
    </style>

    <style name="Widget.Pochi.Button.Play" parent="Widget.Pochi.Button">
        <item name="backgroundTint">@color/btn_play</item>
    </style>

    <style name="Widget.Pochi.Button.Sleep" parent="Widget.Pochi.Button">
        <item name="backgroundTint">@color/btn_sleep</item>
    </style>

    <style name="Widget.Pochi.Button.Pet" parent="Widget.Pochi.Button">
        <item name="backgroundTint">@color/btn_pet</item>
    </style>
</resources>